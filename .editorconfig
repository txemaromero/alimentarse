# https://editorconfig.org  (frontend/ tiene su propio .editorconfig)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
max_line_length = 120

[pom.xml]
indent_style = tab

[*.{cmd,bat,ps1}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
