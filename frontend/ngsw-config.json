{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/icons/icono.svg"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-lecturas",
      "urls": [
        "/api/recetas",
        "/api/ingredientes",
        "/api/grupos",
        "/api/tipos-receta",
        "/api/alimentacion/resumen",
        "/api/consumos",
        "/api/plan"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "7d",
        "maxSize": 300
      }
    },
    {
      "name": "imagenes",
      "urls": ["/api/imagenes"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "30d",
        "maxSize": 200
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/oauth2/**",
    "!/login/oauth2/**"
  ]
}
