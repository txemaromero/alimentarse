# Copia este fichero como .env y rellena los valores. El .env NO se versiona.
# Lo leen Spring Boot (como fichero .properties) y Docker Compose.
# Formato: CLAVE=valor, sin comillas, con los comentarios siempre en líneas propias.
# En rutas de Windows usa barras normales (/): la barra invertida es un carácter de escape.
# Una variable de entorno real tiene prioridad sobre el valor de este fichero.

# --- Base de datos (MySQL 8) ---
# Puerto 3306 con Docker Compose o un MySQL instalado; 3307 con scripts/mysql-portable.ps1
DB_URL=jdbc:mysql://localhost:3306/toca
DB_USER=toca
DB_PASSWORD=
# Solo sin Docker: base de datos de los tests de integración, con el mismo usuario.
# ¡Se BORRA en cada ejecución de tests! Su nombre debe terminar en _test. Con Docker se usa Testcontainers.
TEST_DB_URL=jdbc:mysql://localhost:3307/toca_test

# --- JWT ---
# Secreto de firma de al menos 256 bits. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=8
# Opcional: la cookie de sesión solo viaja por HTTPS. Por defecto, true (en el perfil dev, false)
# COOKIE_SEGURA=true

# --- Correo ---
# En desarrollo, Mailpit: SMTP en el puerto 1025, interfaz web en http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@toca.local

# --- Aplicación ---
# URL pública del frontend; se usa en los enlaces de los correos.
# Con «npm start», http://localhost:4200; con el JAR, http://localhost:8080; en producción, la URL https:// pública.
APP_BASE_URL=http://localhost:4200
# Directorio de las imágenes subidas (relativo al directorio desde el que se arranca)
UPLOAD_DIR=./uploads
# Contraseña del usuario "admin" que se crea en el primer arranque (mínimo 8 caracteres). Vacía = no se crea.
ADMIN_INITIAL_PASSWORD=
# Opcional: email del usuario "admin" (por defecto admin@toca.local)
ADMIN_INITIAL_EMAIL=admin@toca.local
# Opcional, solo en el perfil prod (D-090): rangos CIDR, separados por comas, de los proxies cuyas cabeceras
# X-Forwarded-* se creen. Por defecto, solo esta máquina. Si el proxy está en otra, pon su rango
# (por ejemplo 10.0.0.0/8): si no, los límites de intentos se comparten entre todos los usuarios.
# Vacía, no se confía en ninguno. No la dejes vacía sin querer: anula el valor por defecto.
# PROXIES_DE_CONFIANZA=127.0.0.0/8, ::1/128

# --- Avisos push del planificador (D-078) ---
# Claves VAPID. Vacías = sin avisos. Se generan con: powershell -ExecutionPolicy Bypass -File scripts\generar-claves-push.ps1
# La privada es un secreto. Si se cambian, cada navegador tiene que volver a activar los avisos.
PUSH_CLAVE_PUBLICA=
PUSH_CLAVE_PRIVADA=
# Opcional: contacto para el servicio push, mailto: o https: (por defecto mailto:no-reply@toca.local)
# PUSH_CONTACTO=mailto:no-reply@toca.local

# --- Acceso con Google (D-085) ---
# Cliente OAuth «Aplicación web» de Google Cloud Console (APIs y servicios → Credenciales). Vacías = sin acceso con Google.
# URI de redirección autorizados: {URL de la aplicación}/login/oauth2/code/google, por ejemplo
# http://localhost:8080/login/oauth2/code/google (JAR) y http://localhost:4200/login/oauth2/code/google (npm start).
# El secreto es un secreto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Perfil de Spring: dev | prod ---
# Solo tiene efecto como variable de entorno real (Docker, PaaS). Sin ella, el JAR no arranca (D-089);
# mvnw spring-boot:run usa dev.
SPRING_PROFILES_ACTIVE=dev

# --- Solo para levantar MySQL (Docker Compose o scripts/mysql-portable.ps1) ---
# Contraseña de root de ese MySQL; la aplicación no la usa
MYSQL_ROOT_PASSWORD=

# --- Opcional: perfil «full» de Docker Compose (aplicación en contenedor) ---
# Sustituyen a APP_BASE_URL y SPRING_PROFILES_ACTIVE dentro del contenedor; DB_URL y MAIL_HOST ya los fija Compose.
# El contenedor solo recibe las variables que lista docker-compose.yml, no todo este fichero (D-090).
# APP_BASE_URL_DOCKER=http://localhost:8080
# SPRING_PROFILES_ACTIVE_DOCKER=prod
